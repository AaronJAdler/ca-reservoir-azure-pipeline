{#- Checks over one staged run. One row per rule: rule_id, severity, failed.
    Any fatal rule with failed > 0 stops the run before publish. -#}
WITH staged AS (
    SELECT * FROM {{ staging() }} AS x
),
data_rows AS (
    SELECT * FROM staged WHERE is_header = 0
),
good_rows AS (
    SELECT * FROM data_rows WHERE reject_reason IS NULL
),
dupes AS (
    SELECT station_id, reading_date
    FROM data_rows
    WHERE reading_date IS NOT NULL
    GROUP BY station_id, reading_date
    HAVING COUNT(*) > 1
),
distinct_days AS (
    SELECT DISTINCT station_id, reading_date
    FROM data_rows
    WHERE reject_reason IS NULL OR reject_reason IN ('bad_value', 'implausible_value')
),
expected AS (
    SELECT {{ station_count }} * ({{ days_between("CAST('" ~ window_start ~ "' AS DATE)", "CAST('" ~ window_end ~ "' AS DATE)") }} + 1) AS n
)
SELECT 'F1_header' AS rule_id, 'fatal' AS severity,
    CASE
        WHEN (SELECT COUNT(*) FROM staged WHERE is_header = 1) = 1
            AND (SELECT COALESCE(SUM(header_ok), 0) FROM staged) = 1
        THEN 0 ELSE 1
    END AS failed
UNION ALL
SELECT 'F2_contract', 'fatal',
    (SELECT COUNT(*) FROM data_rows
     WHERE reject_reason IN ('unknown_station', 'unexpected_sensor', 'bad_date', 'outside_window'))
UNION ALL
SELECT 'F3_duplicate_keys', 'fatal', (SELECT COUNT(*) FROM dupes)
UNION ALL
SELECT 'F4_completeness', 'fatal',
    CASE
        WHEN (SELECT n FROM expected) > (SELECT COUNT(*) FROM distinct_days)
        THEN (SELECT n FROM expected) - (SELECT COUNT(*) FROM distinct_days)
        ELSE 0
    END
UNION ALL
SELECT 'F5_window', 'fatal',
    CASE
        WHEN {{ days_between("CAST('" ~ window_start ~ "' AS DATE)", "CAST('" ~ window_end ~ "' AS DATE)") }} < 0
        THEN 1 ELSE 0
    END
UNION ALL
SELECT 'W1_missing_value', 'warning', (SELECT COUNT(*) FROM good_rows WHERE is_missing = 1)
UNION ALL
SELECT 'W2_estimated', 'warning', (SELECT COUNT(*) FROM good_rows WHERE is_estimated = 1)
UNION ALL
SELECT 'W3_revised_flag', 'warning', (SELECT COUNT(*) FROM good_rows WHERE is_revised = 1)
UNION ALL
SELECT 'W4_rejected_row', 'warning',
    (SELECT COUNT(*) FROM data_rows WHERE reject_reason IN ('bad_value', 'implausible_value'))
UNION ALL
SELECT 'W5_unknown_flag', 'warning',
    (SELECT COUNT(*) FROM good_rows WHERE data_flag IS NOT NULL AND data_flag NOT IN ('e', 'r'))
