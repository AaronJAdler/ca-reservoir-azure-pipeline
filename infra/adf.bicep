// Data Factory linked services, datasets, pipeline and (stopped) trigger.
// The SQL the pipeline runs is generated by `resflow render` into
// infra/generated/ and embedded here at build time.

param factoryName string
param lakeDfsUrl string
param serverlessEndpoint string
param serverlessDatabase string
param stations string

var pipelineName = 'pl_cdec_reservoir_daily'
var triggerName = 'tr_daily_1530_utc'

resource factory 'Microsoft.DataFactory/factories@2018-06-01' existing = {
  name: factoryName
}

// ---------------------------------------------------------------- Linked services

resource lsCdec 'Microsoft.DataFactory/factories/linkedservices@2018-06-01' = {
  parent: factory
  name: 'ls_cdec_http'
  properties: {
    type: 'HttpServer'
    description: 'CDEC public CSV servlet. No credentials.'
    typeProperties: {
      url: 'https://cdec.water.ca.gov/'
      authenticationType: 'Anonymous'
      enableServerCertificateValidation: true
    }
  }
}

resource lsLake 'Microsoft.DataFactory/factories/linkedservices@2018-06-01' = {
  parent: factory
  name: 'ls_lake'
  properties: {
    type: 'AzureBlobFS'
    description: 'ADLS Gen2 through the factory managed identity (no keys).'
    typeProperties: {
      url: lakeDfsUrl
    }
  }
}

resource lsSynapse 'Microsoft.DataFactory/factories/linkedservices@2018-06-01' = {
  parent: factory
  name: 'ls_synapse_serverless'
  properties: {
    type: 'AzureSqlDW'
    description: 'Synapse serverless SQL endpoint through the factory managed identity.'
    typeProperties: {
      server: serverlessEndpoint
      database: serverlessDatabase
      encrypt: 'mandatory'
      trustServerCertificate: false
      authenticationType: 'SystemAssignedManagedIdentity'
    }
  }
}

// ---------------------------------------------------------------- Datasets

resource dsCdec 'Microsoft.DataFactory/factories/datasets@2018-06-01' = {
  parent: factory
  name: 'ds_cdec_csv'
  properties: {
    type: 'Binary'
    linkedServiceName: {
      referenceName: lsCdec.name
      type: 'LinkedServiceReference'
    }
    parameters: {
      relativeUrl: {
        type: 'string'
      }
    }
    typeProperties: {
      location: {
        type: 'HttpServerLocation'
        relativeUrl: {
          value: '@dataset().relativeUrl'
          type: 'Expression'
        }
      }
    }
  }
}

resource dsLakeFile 'Microsoft.DataFactory/factories/datasets@2018-06-01' = {
  parent: factory
  name: 'ds_lake_file'
  properties: {
    type: 'Binary'
    linkedServiceName: {
      referenceName: lsLake.name
      type: 'LinkedServiceReference'
    }
    parameters: {
      folderPath: {
        type: 'string'
      }
      fileName: {
        type: 'string'
      }
    }
    typeProperties: {
      location: {
        type: 'AzureBlobFSLocation'
        fileSystem: 'lake'
        folderPath: {
          value: '@dataset().folderPath'
          type: 'Expression'
        }
        fileName: {
          value: '@dataset().fileName'
          type: 'Expression'
        }
      }
    }
  }
}

resource dsLakeFolder 'Microsoft.DataFactory/factories/datasets@2018-06-01' = {
  parent: factory
  name: 'ds_lake_folder'
  properties: {
    type: 'Binary'
    linkedServiceName: {
      referenceName: lsLake.name
      type: 'LinkedServiceReference'
    }
    parameters: {
      folderPath: {
        type: 'string'
      }
    }
    typeProperties: {
      location: {
        type: 'AzureBlobFSLocation'
        fileSystem: 'lake'
        folderPath: {
          value: '@dataset().folderPath'
          type: 'Expression'
        }
      }
    }
  }
}

resource dsSynapse 'Microsoft.DataFactory/factories/datasets@2018-06-01' = {
  parent: factory
  name: 'ds_synapse_serverless'
  properties: {
    type: 'AzureSqlDWTable'
    linkedServiceName: {
      referenceName: lsSynapse.name
      type: 'LinkedServiceReference'
    }
    typeProperties: {}
  }
}

// ---------------------------------------------------------------- Pipeline

var stageSql = loadTextContent('generated/stage_run.sql')
var checksSql = loadTextContent('generated/checks.sql')

var cdecRelativeUrl = 'dynamicapp/req/CSVDataServlet?Stations=@{variables(\'stations\')}&SensorNums=15&dur_code=D&Start=@{variables(\'windowStart\')}&End=@{variables(\'windowEnd\')}'
var bronzeFolder = 'bronze/cdec/sensor=15/run_id=@{pipeline().RunId}'
var stagingFolder = 'staging/reservoir_storage/run_id=@{pipeline().RunId}'
var silverFolder = 'silver/reservoir_storage/run_id=@{pipeline().RunId}'

var copyPolicy = {
  timeout: '0.00:15:00'
  retry: 3
  retryIntervalInSeconds: 60
  secureOutput: false
  secureInput: false
}

// SQL steps are not retried: CETAS fails if its target folder already has files.
var sqlPolicy = {
  timeout: '0.00:15:00'
  retry: 0
  secureOutput: false
  secureInput: false
}

resource pipeline 'Microsoft.DataFactory/factories/pipelines@2018-06-01' = {
  parent: factory
  name: pipelineName
  properties: {
    description: 'Pull a trailing window of CDEC daily reservoir storage, land it raw, parse and check it in Synapse serverless, and publish to silver only if no fatal check failed.'
    parameters: {
      windowStart: {
        type: 'string'
        defaultValue: ''
      }
      windowEnd: {
        type: 'string'
        defaultValue: ''
      }
      lookbackDays: {
        type: 'int'
        defaultValue: 30
      }
      stations: {
        type: 'string'
        defaultValue: stations
      }
    }
    variables: {
      windowStart: {
        type: 'String'
      }
      windowEnd: {
        type: 'String'
      }
      stations: {
        type: 'String'
      }
    }
    activities: [
      {
        name: 'SetWindowEnd'
        type: 'SetVariable'
        typeProperties: {
          variableName: 'windowEnd'
          value: {
            value: '@if(empty(pipeline().parameters.windowEnd), formatDateTime(addDays(utcNow(), -1), \'yyyy-MM-dd\'), pipeline().parameters.windowEnd)'
            type: 'Expression'
          }
        }
      }
      {
        name: 'SetWindowStart'
        type: 'SetVariable'
        dependsOn: [
          {
            activity: 'SetWindowEnd'
            dependencyConditions: ['Succeeded']
          }
        ]
        typeProperties: {
          variableName: 'windowStart'
          value: {
            value: '@if(empty(pipeline().parameters.windowStart), formatDateTime(addDays(variables(\'windowEnd\'), mul(-1, pipeline().parameters.lookbackDays)), \'yyyy-MM-dd\'), pipeline().parameters.windowStart)'
            type: 'Expression'
          }
        }
      }
      {
        name: 'SetStations'
        type: 'SetVariable'
        typeProperties: {
          variableName: 'stations'
          value: {
            value: '@pipeline().parameters.stations'
            type: 'Expression'
          }
        }
      }
      {
        name: 'LandBronze'
        description: 'Copy the CDEC response byte for byte into bronze. Validation happens in SQL, not here.'
        type: 'Copy'
        policy: copyPolicy
        dependsOn: [
          {
            activity: 'SetWindowStart'
            dependencyConditions: ['Succeeded']
          }
          {
            activity: 'SetStations'
            dependencyConditions: ['Succeeded']
          }
        ]
        inputs: [
          {
            referenceName: dsCdec.name
            type: 'DatasetReference'
            parameters: {
              relativeUrl: {
                value: cdecRelativeUrl
                type: 'Expression'
              }
            }
          }
        ]
        outputs: [
          {
            referenceName: dsLakeFile.name
            type: 'DatasetReference'
            parameters: {
              folderPath: {
                value: bronzeFolder
                type: 'Expression'
              }
              fileName: 'cdec.csv'
            }
          }
        ]
        typeProperties: {
          source: {
            type: 'BinarySource'
            storeSettings: {
              type: 'HttpReadSettings'
              requestMethod: 'GET'
            }
          }
          sink: {
            type: 'BinarySink'
            storeSettings: {
              type: 'AzureBlobFSWriteSettings'
            }
          }
          enableStaging: false
        }
      }
      {
        name: 'StageParse'
        description: 'CETAS: parse bronze into typed Parquet under staging/. Rows are kept with a reject_reason.'
        type: 'Script'
        policy: sqlPolicy
        dependsOn: [
          {
            activity: 'LandBronze'
            dependencyConditions: ['Succeeded']
          }
        ]
        linkedServiceName: {
          referenceName: lsSynapse.name
          type: 'LinkedServiceReference'
        }
        typeProperties: {
          scripts: [
            {
              type: 'NonQuery'
              text: {
                value: stageSql
                type: 'Expression'
              }
            }
          ]
          scriptBlockExecutionTimeout: '00:15:00'
        }
      }
      {
        name: 'RunChecks'
        description: 'One row per rule: rule_id, severity, failed.'
        type: 'Lookup'
        policy: sqlPolicy
        dependsOn: [
          {
            activity: 'StageParse'
            dependencyConditions: ['Succeeded']
          }
        ]
        typeProperties: {
          source: {
            type: 'SqlDWSource'
            sqlReaderQuery: {
              value: checksSql
              type: 'Expression'
            }
            queryTimeout: '00:15:00'
          }
          dataset: {
            referenceName: dsSynapse.name
            type: 'DatasetReference'
          }
          firstRowOnly: false
        }
      }
      {
        name: 'FatalChecks'
        type: 'Filter'
        dependsOn: [
          {
            activity: 'RunChecks'
            dependencyConditions: ['Succeeded']
          }
        ]
        typeProperties: {
          items: {
            value: '@activity(\'RunChecks\').output.value'
            type: 'Expression'
          }
          condition: {
            value: '@and(equals(item().severity, \'fatal\'), greater(item().failed, 0))'
            type: 'Expression'
          }
        }
      }
      {
        name: 'PublishOrFail'
        type: 'IfCondition'
        dependsOn: [
          {
            activity: 'FatalChecks'
            dependencyConditions: ['Succeeded']
          }
        ]
        typeProperties: {
          expression: {
            value: '@greater(activity(\'FatalChecks\').output.FilteredItemsCount, 0)'
            type: 'Expression'
          }
          ifTrueActivities: [
            {
              name: 'FailRun'
              type: 'Fail'
              typeProperties: {
                message: {
                  value: '@concat(\'Fatal checks failed; nothing published. Staging kept for inspection. \', string(activity(\'FatalChecks\').output.Value))'
                  type: 'Expression'
                }
                errorCode: 'FATAL_CHECKS'
              }
            }
          ]
          ifFalseActivities: [
            {
              name: 'PublishSilver'
              type: 'Copy'
              policy: copyPolicy
              inputs: [
                {
                  referenceName: dsLakeFolder.name
                  type: 'DatasetReference'
                  parameters: {
                    folderPath: {
                      value: stagingFolder
                      type: 'Expression'
                    }
                  }
                }
              ]
              outputs: [
                {
                  referenceName: dsLakeFolder.name
                  type: 'DatasetReference'
                  parameters: {
                    folderPath: {
                      value: silverFolder
                      type: 'Expression'
                    }
                  }
                }
              ]
              typeProperties: {
                source: {
                  type: 'BinarySource'
                  storeSettings: {
                    type: 'AzureBlobFSReadSettings'
                    recursive: true
                  }
                }
                sink: {
                  type: 'BinarySink'
                  storeSettings: {
                    type: 'AzureBlobFSWriteSettings'
                    copyBehavior: 'PreserveHierarchy'
                  }
                }
                enableStaging: false
              }
            }
            {
              name: 'DeleteStaging'
              type: 'Delete'
              policy: copyPolicy
              dependsOn: [
                {
                  activity: 'PublishSilver'
                  dependencyConditions: ['Succeeded']
                }
              ]
              typeProperties: {
                dataset: {
                  referenceName: dsLakeFolder.name
                  type: 'DatasetReference'
                  parameters: {
                    folderPath: {
                      value: stagingFolder
                      type: 'Expression'
                    }
                  }
                }
                storeSettings: {
                  type: 'AzureBlobFSReadSettings'
                  recursive: true
                }
                enableLogging: false
              }
            }
          ]
        }
      }
    ]
  }
}

// Deployed stopped (ARM's default for triggers). Start it only if you want
// scheduled runs: az datafactory trigger start ...
resource trigger 'Microsoft.DataFactory/factories/triggers@2018-06-01' = {
  parent: factory
  name: triggerName
  properties: {
    type: 'ScheduleTrigger'
    description: 'Daily at 15:30 UTC, after CDEC posts the previous day.'
    typeProperties: {
      recurrence: {
        frequency: 'Day'
        interval: 1
        startTime: '2026-01-01T15:30:00Z'
        timeZone: 'UTC'
      }
    }
    pipelines: [
      {
        pipelineReference: {
          referenceName: pipeline.name
          type: 'PipelineReference'
        }
        parameters: {}
      }
    ]
  }
}

output pipelineName string = pipeline.name
output triggerName string = trigger.name
